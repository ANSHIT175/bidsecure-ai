{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/analyze.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/analyze", "destination": "/api/analyze.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
